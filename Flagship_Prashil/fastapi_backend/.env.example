# AWS RDS: replace all values; never commit the actual .env file.
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# Set true in deployed environments to fail fast if RDS is not reachable.
DATABASE_CONNECT_ON_STARTUP=true

# Private S3 media storage (eu-west-2).
AWS_REGION=eu-west-2
S3_MEDIA_BUCKET=your-private-media-bucket
S3_MEDIA_PREFIX=media/
S3_PRESIGNED_URL_EXPIRES_SECONDS=3600
S3_MAX_UPLOAD_BYTES=26214400

# Optional local/dev credentials. On Lightsail use the instance IAM role instead.
# Never commit real keys; boto3 also reads these from the process environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Firebase Auth is retained for identity verification only.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
FIREBASE_STORAGE_BUCKET=deckoviz-app.appspot.com
SECRET_KEY=replace-with-a-long-random-secret
