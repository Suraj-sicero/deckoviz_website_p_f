generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(uuid())
  role        String   // "student", "teacher", "admin"
  name        String
  email       String   @unique
  createdAt   DateTime @default(now())
  
  classes     Class[]
  sessions    Session[]
  collections Collection[]
  journals    JournalEntry[]
}

model Class {
  id          String   @id @default(uuid())
  name        String
  subject     String
  gradeLevel  String
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  sessions    Session[]
}

model Session {
  id          String   @id @default(uuid())
  title       String
  type        String   // "vizzy_chat", "classroom", "career", etc.
  content     String   // JSON string of messages or session data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Collection {
  id          String   @id @default(uuid())
  title       String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  artworks    Artwork[]
}

model Artwork {
  id           String     @id @default(uuid())
  title        String
  type         String     // "image", "audio", "text"
  mediaUrl     String?
  color        String?
  
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])
}

model JournalEntry {
  id          String   @id @default(uuid())
  content     String
  sentiment   String?
  tags        String   // JSON array of strings
  createdAt   DateTime @default(now())
  
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
}
